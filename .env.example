# LLM (DashScope OpenAI-compatible)
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Fast code model (iterate / completeness / repair)
LLM_MODEL=qwen3-coder-flash
# Strong planner model (spec / initial build) — richer planning
LLM_MODEL_PLANNER=deepseek-v4.1-flash
# Optional per-request timeout (ms)
LLM_TIMEOUT_MS=120000

# Platform
SESSION_SECRET=change-me
DB_PATH=./data/app.db
DATA_ROOT=./storage/projects
BASE_URL=http://localhost:3000

# Sandbox
SANDBOX_IMAGE=ivanatoms/base:node22
RUNTIME_ISOLATION=container